.env
node_modules

/generated/prisma

/generated/prisma

# Document signing identity — private key, never committed
.secrets/

# Local blob store for development (src/service/blobStore.ts)
.localblobs/

# Build output. Railway compiles from source on deploy (proven 2026-10-26:
# a tag changed in TypeScript only, with dist/ left stale, appeared in
# production), so committing it only produced diff noise and conflicts.
dist/

# Output of e2e_pades.ts — rewritten on every run, read by nothing. It was
# committed once and has shown as modified ever since, so every status and
# every diff carried it.
pades-signed.pdf
